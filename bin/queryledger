#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'query_ledger'
require 'optparse'

begin
  command = ARGV.shift
  options = {}
  parser = OptionParser.new do |o|
    o.banner = 'queryledger compare|record --baseline FILE --report FILE [--accept]'
    o.on('--baseline FILE') { |v| options[:baseline] = v }
    o.on('--report FILE') { |v| options[:report] = v }
    o.on('--accept', 'Explicitly accept every observed count as its budget') { options[:accept] = true }
    o.on('--help') { puts o; exit 0 }
  end
  if ['--help', '-h', nil].include?(command)
    puts parser
    exit(command.nil? ? 2 : 0)
  end
  parser.parse!
  raise QueryLedger::Error, parser.banner unless options[:baseline] && options[:report] && ARGV.empty?
  samples = QueryLedger.read_json(options[:report], 'samples')['samples']
  raise QueryLedger::Error, 'Report contains no samples' if samples.empty?
  case command
  when 'compare'
    budgets = QueryLedger.read_json(options[:baseline], 'budgets')['budgets']
    missing = budgets.keys - samples.keys
    raise QueryLedger::Error, "Report is missing budgeted samples: #{missing.join(', ')}" unless missing.empty?
    results = samples.map { |key, sample| QueryLedger.compare(sample, budgets[key], key: key) }
    results.each { |r| puts QueryLedger.message(r) }
    exit(results.all? { |r| r['passed'] } ? 0 : 1)
  when 'record'
    raise QueryLedger::Error, 'Recording requires --accept; review the report first' unless options[:accept]
    budgets = File.exist?(options[:baseline]) ? QueryLedger.read_json(options[:baseline], 'budgets')['budgets'] : {}
    samples.each { |key, sample| budgets[key] = { 'max' => sample['count'], 'patterns' => sample['patterns'] } }
    QueryLedger.atomic_write(options[:baseline], { 'schema_version' => 1, 'budgets' => budgets })
    puts "Recorded #{samples.length} explicit budgets in #{options[:baseline]}"
  else
    raise QueryLedger::Error, "Unknown command: #{command}"
  end
rescue QueryLedger::Error, OptionParser::ParseError, SystemCallError => e
  warn e.message
  exit 2
end
